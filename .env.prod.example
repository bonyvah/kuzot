# Production settings. On the server: copy to /opt/kuzot/.env and fill in.
# docker-compose.prod.yml reads it twice: for its own ${VARIABLES} and as the
# backend's environment. Generate each password with:  openssl rand -hex 24
# (hex only: they go into connection URLs unescaped)

# ── Where it runs ──────────────────────────────────────────────
DOMAIN=kuzot.example.com
# Let's Encrypt account email; leave empty to keep a self-signed certificate
CERTBOT_EMAIL=you@example.com

# Images to run; deploy.yml pushes :latest and :<commit sha>
IMAGE_PREFIX=ghcr.io/bonyvah/kuzot
TAG=latest

# ── Internal services ──────────────────────────────────────────
POSTGRES_PASSWORD=
MONGO_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_PASSWORD=
MINIO_PASSWORD=
S3_BUCKET_MEDIA=kuzot-media

# ── Auth: openssl rand -hex 32, two different values ───────────
JWT_SECRET_KEY=
JWT_REFRESH_SECRET_KEY=

# ── AI ─────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_REPORT_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Pinecone cloud: the index is found by name (no PINECONE_HOST in production)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=kuzot
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ── Scraping ───────────────────────────────────────────────────
# public page describing the crawler, sent in its User-Agent
BOT_INFO_URL=https://kuzot.example.com/bot

# ── Optional: features stay off without a key ──────────────────
TAVILY_API_KEY=
APIFY_TOKEN=
# Tracing, e.g. Langfuse:
# OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64 of public_key:secret_key>
