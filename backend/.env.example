# Database
DATABASE_URL=postgresql+asyncpg://kuzot:secret@postgres:5432/kuzot
MONGO_URI=mongodb://mongodb:27017/kuzot
REDIS_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# AI
OPENAI_API_KEY=sk-...
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX_NAME=kuzot-ci-index
# Pinecone Local (docker compose service); leave empty in prod to resolve the index by name
PINECONE_HOST=http://pinecone.internal:5081
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
OPENAI_REPORT_MODEL=gpt-5.4-mini

# Auth — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-random-64-char-hex-string
JWT_REFRESH_SECRET_KEY=change-this-to-a-different-random-64-char-hex-string
# Set false only when serving over plain http on a host other than localhost.
REFRESH_COOKIE_SECURE=true

# Broker
RABBITMQ_URL=amqp://kuzot:secret@rabbitmq:5672/

# AWS / LocalStack (leave AWS_ENDPOINT_URL empty in production)
AWS_ENDPOINT_URL=http://localstack:4566
AWS_REGION=us-east-1
S3_BUCKET_REPORTS=kuzot-reports
