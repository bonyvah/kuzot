# Database
DATABASE_URL=postgresql+asyncpg://kuzot:secret@localhost:5432/kuzot
MONGO_URI=mongodb://localhost:27017/kuzot
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# AI
OPENAI_API_KEY=sk-...
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX_NAME=kuzot-ci-index

# Auth — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-random-64-char-hex-string
JWT_REFRESH_SECRET_KEY=change-this-to-a-different-random-64-char-hex-string

# Broker
RABBITMQ_URL=amqp://kuzot:secret@rabbitmq:5672/

# AWS / LocalStack (leave AWS_ENDPOINT_URL empty in production)
AWS_ENDPOINT_URL=http://localstack:4566
AWS_REGION=us-east-1
S3_BUCKET_REPORTS=kuzot-reports
